{
  "platform": ["telegram", "discord"],
  "persona": "../persona-and-memory/examples/persona.json",
  "memory_root": "../persona-and-memory/examples/memory",
  "state_file": "bot-state.json",
  "cycle_script": "../persona-and-memory/scripts/memory_cycle.py",
  "record_episodes": "auto",
  "reply": { "include_memory": true },
  "model": { "mode": "offline" },
  "beat": {
    "interval_seconds": 900,
    "quiet_hours": [23, 7],
    "min_gap_minutes": 20,
    "nudge_after_hours": 6,
    "nudge_cooldown_hours": 12,
    "max_messages_per_day": 3,
    "min_weight": 0.5
  },
  "telegram": {
    "token_env": "FISH_TG_TOKEN",
    "allow_chat_ids": [123456789, -100999],
    "allow_user_ids": []
  },
  "discord": {
    "token_env": "FISH_DISCORD_TOKEN",
    "allow_channel_ids": ["123456789012345678"],
    "allow_user_ids": []
  },
  "limits": {
    "max_messages_per_minute": 6,
    "max_message_chars": 800
  },
  "proactive": {
    "enabled": false,
    "platform": "telegram",
    "target": "",
    "interval_seconds": 900,
    "include_memory": false
  },
  "chats": {
    "private": {
      "include_memory": true,
      "record": true
    },
    "-100999": {
      "include_memory": false,
      "record": false,
      "proactive": {
        "enabled": false,
        "interval_seconds": 1800,
        "quiet_hours": [22, 8],
        "max_messages_per_day": 2
      }
    }
  }
}
